# Supply-chain hardening directives (SC-12282), same set as the Playwright and
# WebdriverIO load-testing samples (LTS-3294 / LTS-3295).
# See: https://browserstack.atlassian.net/wiki/spaces/ENG/pages/6091571922/Supply+Chain+Security+Enhancements+Tech+Spec
#
# access=restricted is intentionally OMITTED — this is a public, customer-facing
# sample repository, not a published private package.
#
# ignore-scripts=true is safe: this sample has no install scripts of its own, and the
# tests run remotely on BrowserStack, so no local browser-driver postinstall is needed.
#
# engine-strict=true enforces the `engines.node` floors of this package (>=20) and of
# its dependencies (serialize-javascript needs >=20), so an older Node fails at install.

strict-ssl=true
save-exact=true
audit-level=high
legacy-peer-deps=false
ignore-scripts=true
engine-strict=true
min-release-age=7
